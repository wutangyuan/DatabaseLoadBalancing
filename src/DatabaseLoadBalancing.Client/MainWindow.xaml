<Window x:Class="DatabaseLoadBalancing.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQLite 数据库服务客户端" Height="720" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="连接" Click="Connect_Click" Width="100" />
            <TextBlock Text="TCP 服务地址" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="ServiceUrlTextBox" Text="127.0.0.1:5080" Width="300" VerticalContentAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="数据库表" Grid.Column="0">
                <ListBox x:Name="TablesListBox" DisplayMemberPath="Name" SelectionChanged="TablesListBox_SelectionChanged" />
            </GroupBox>
            <GroupBox Header="记录" Grid.Column="2">
                <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RowId" Binding="{Binding RowId}" Width="100" />
                        <DataGridTextColumn Header="数据" Binding="{Binding Json}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusTextBlock" Text="未连接" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="刷新" Click="Refresh_Click" />
                <Button Content="新增" Click="Add_Click" />
                <Button Content="编辑" Click="Edit_Click" />
                <Button Content="删除" Click="Delete_Click" />
                <Button Content="清空" Click="Clear_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

