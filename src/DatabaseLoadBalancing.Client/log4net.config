<?xml version="1.0" encoding="utf-8" ?>
<log4net>
  <appender name="ColoredConsole" type="log4net.Appender.ColoredConsoleAppender, log4net">
    <mapping><level value="INFO" /><foreColor value="White" /></mapping>
    <mapping><level value="WARN" /><foreColor value="Yellow" /></mapping>
    <mapping><level value="ERROR" /><foreColor value="Red" /></mapping>
    <layout type="log4net.Layout.PatternLayout"><conversionPattern value="%date %-5level %message%newline" /></layout>
  </appender>
  <root><level value="INFO" /><appender-ref ref="ColoredConsole" /></root>
</log4net>
